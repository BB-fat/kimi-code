"REST /api/v1/sessions/{session_id}/snapshot
{
  "get": {
    "tags": [
      "sessions"
    ],
    "description": "Atomic session snapshot for client rebuild: state + as_of_seq watermark + epoch",
    "parameters": [
      {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "in": "path",
        "name": "session_id",
        "required": true
      }
    ],
    "responses": {
      "200": {
        "description": "Default Response",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "enum": [
                        0
                      ]
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "as_of_seq": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "epoch": {
                          "type": "string",
                          "minLength": 1
                        },
                        "session": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            },
